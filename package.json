{
  "name": "pgmoat-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:corpus": "vitest run --project corpus",
    "test:heldout": "vitest run --project heldout",
    "test:corpus:db": "vitest run --project corpus-db",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --project bench",
    "build": "pnpm --filter pgmoat build",
    "check:licenses": "node tools/check-licenses.mjs",
    "gen:errors": "node tools/gen-errors.mjs",
    "check:errors": "node tools/gen-errors.mjs --check",
    "check:docs": "node tools/gen-docs.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/pino": "^7.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
