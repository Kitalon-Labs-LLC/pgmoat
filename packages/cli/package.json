    "agents",
    "claude",
    "read-only",
    "rls",
    "audit"
  ],
  "license": "MIT",
  "author": "Kitalon Labs",
  "homepage": "https://kitalonlabs.com/pgmoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kitalon-Labs-LLC/pgmoat.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Kitalon-Labs-LLC/pgmoat/issues"
  },
  "type": "module",
  "bin": {
    "pgmoat": "./dist/bin.mjs"
  },
  "engines": {
