{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PgmoatConfig",
  "type": "object",
  "required": [
    "version",
    "server",
    "transport",
    "connection",
    "mode",
    "budgets",
    "audit"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "server": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "string",
      "enum": [
        "stdio",
        "http"
      ]
    },
    "mode": {
      "type": "string",
      "const": "read-only"
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_rows",
        "max_query_ms",
        "max_payload_bytes"
      ],
      "properties": {
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_query_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_columns": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
